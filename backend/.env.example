# Server
PORT=5000
NODE_ENV=development

# Database
# Leave empty in development to use the built-in local database (%LOCALAPPDATA%\shopme\db).
# In production, set this to your MongoDB Atlas connection string.
MONGODB_URI=

# Allowed website addresses (comma-separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Customer website address, used for links in emails (e.g. password reset)
STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Auth (Phase 2/3)
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-too

# The single admin account is created from these on first start only.
# After that, change the password from the admin panel (My Account).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Razorpay (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Phase 7): the owner's Gmail with a Google "App Password" (needs 2-Step
# Verification; create it at myaccount.google.com → Security → App passwords).
# Until SMTP_USER and SMTP_PASS are set, emails are only written to the server log.
EMAIL_FROM="SHOPME <you@gmail.com>"
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API (Phase 7)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Media storage (photos and videos) and online backup copies: Cloudinary
# Without these, uploads stay on this computer (%LOCALAPPDATA%\shopme\uploads).
# Either paste the "API environment variable" from the Cloudinary dashboard:
CLOUDINARY_URL=
# ...or fill in the three parts:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for this store's files in Cloudinary
CLOUDINARY_FOLDER=shopme

# Daily database backup (after 2 AM India time)
# BACKUP_KEY encrypts each backup; the online copy (Cloudinary) is only made when it is set.
# Use 32+ random characters and keep a copy somewhere safe: without it a backup can't be opened.
BACKUP_KEY=
# Days to keep backups (online and on the server)
BACKUP_KEEP_DAYS=30
# Server copy folder (default %LOCALAPPDATA%\shopme\backups)
BACKUP_PATH=

# SMS gateway (NetworkZ Systems) for OTP login/registration.
# Until token key and template are set, development shows the OTP on screen; production refuses OTP.
SMS_API_BASE=https://message.networkzsystems.com/api/sms/v1.0
SMS_ACCESS_TOKEN=
SMS_ACCESS_TOKEN_KEY=
SMS_ENTITY_ID=
SMS_HEADER=
SMS_TEMPLATE_ID=
# DLT-approved template text, word for word, with {#var#} where the OTP goes
SMS_OTP_TEMPLATE=
SMS_ROUTE=transactional

# Behind a hosting proxy (Render, Nginx, Cloudflare…) set to 1 so per-visitor limits see real addresses
TRUST_PROXY=0

# Single-server hosting (optional): the API server also serves the built store at /
# and the built admin panel at /admin (build both with "npm run build:server" from the project folder).
# Example: STORE_DIST=../frontend/dist  ADMIN_DIST=../admin/dist
# Leave empty when the store and admin are hosted as separate static sites.
STORE_DIST=
ADMIN_DIST=
