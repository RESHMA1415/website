# Server
PORT=5000
NODE_ENV=development

# Database
# Leave empty in development to use the built-in local database (%LOCALAPPDATA%\shopme\db).
# In production, set this to your MongoDB Atlas connection string.
MONGODB_URI=

# Allowed website addresses (comma-separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Customer website address, used for links in emails (e.g. password reset)
STORE_URL=http://localhost:5173

# Auth (Phase 2/3)
JWT_SECRET=change-me
ADMIN_JWT_SECRET=change-me-too

# The single admin account is created from these on first start only.
# After that, change the password from the admin panel (My Account).
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Razorpay (Phase 4)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Phase 7). Until these are set, emails (welcome, password reset) are
# only written to the server log and the Notification Log, not sent.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API (Phase 7)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Media storage
# Development keeps uploads on this computer (%LOCALAPPDATA%\shopme\uploads).
# Cloudinary is connected before launch (Phase 9).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
